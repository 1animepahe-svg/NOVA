name: NOVA Agent (Linux + browser)
on:
  workflow_dispatch:
    inputs:
      task:
        description: "What should NOVA do?"
        required: true
      request_id:
        description: "Leave empty (used by the NOVA app)"
        required: false
        default: "manual"
permissions:
  contents: write
  actions: read
jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: pip install browser-use && playwright install --with-deps chromium
      - run: python agent/agent.py
        env:
          TASK: ${{ inputs.task }}
          GOOGLE_API_KEY: ${{ secrets.GEMINI_KEY }}
          X_USER: ${{ secrets.X_USER }}
          X_PASS: ${{ secrets.X_PASS }}
          PIN_USER: ${{ secrets.PIN_USER }}
          PIN_PASS: ${{ secrets.PIN_PASS }}
      - uses: actions/upload-artifact@v4
        if: always()
        with: { name: nova-run, path: agent/out }
      - name: Send report back to the NOVA app
        if: always()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RID: ${{ inputs.request_id }}
        run: |
          mkdir -p /tmp/r
          cp agent/out/report.txt "/tmp/r/$RID.txt" 2>/dev/null || echo "NOVA Agent stopped before finishing. Open the Actions tab for the log." > "/tmp/r/$RID.txt"
          URL="https://x-access-token:${GH_TOKEN}@github.com/${{ github.repository }}"
          cd /tmp
          git clone -q --branch nova-reports --single-branch "$URL" rep || (mkdir rep && cd rep && git init -q -b nova-reports && git remote add origin "$URL")
          cd rep && mkdir -p reports && cp /tmp/r/*.txt reports/
          git add . && git -c user.name=nova-bot -c user.email=nova-bot@users.noreply.github.com commit -qm "report $RID" && git push -q origin nova-reports
